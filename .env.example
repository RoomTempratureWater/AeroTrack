# Flight Tracker Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (Persistent volume for Coolify)
DATABASE_URL=sqlite+aiosqlite:///data/flights.db

# Startup
RUN_SCRAPE_ON_STARTUP=true
DEFAULT_CURRENCY=INR

# ── Multi-Date Tracker Settings ──────────────────────────────────────────────
# Maximum number of simultaneously active date trackers (hard cap in UI + API)
MAX_ACTIVE_TRACKERS=5

# How many times per day each active tracker is scraped
MAX_SCRAPES_PER_DAY=3

# Comma-separated HH:MM times in IST (UTC+5:30) to run the daily scrape jobs
# Default: 08:00, 13:00, 20:00 IST
SCRAPE_TIMES_IST=08:00,13:00,20:00

# ── Bright Data Integration ───────────────────────────────────────────────────
# Protects your IP from rate limits and blocks. Leave blank for direct connection.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=serp_api1
BRIGHT_DATA_API_URL=https://api.brightdata.com/request

# Alternative: Standard Proxy URL (if using BrightData Proxy Manager or SuperProxy)
# e.g., http://brd-customer-hl_xxx-zone-serp_api1:password@brd.superproxy.io:22225
BRIGHT_DATA_PROXY_URL=
