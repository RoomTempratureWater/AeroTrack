# Flight Tracker Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (Persistent volume for Coolify)
DATABASE_URL=sqlite+aiosqlite:///data/flights.db

# Scheduler Settings
CHECK_INTERVAL_MINUTES=60
RUN_SCRAPE_ON_STARTUP=true

# Tracking Settings
# Options: "today", "tomorrow", or "both"
TRACK_DATE_MODE=today
DEFAULT_CURRENCY=INR

# Bright Data Integration (Protects your IP from rate limits and blocks)
# Leave blank for direct connection during development
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=serp_api1
BRIGHT_DATA_API_URL=https://api.brightdata.com/request

# Alternative: Standard Proxy URL (if using BrightData Proxy Manager or SuperProxy)
# e.g., http://brd-customer-hl_xxx-zone-serp_api1:password@brd.superproxy.io:22225
BRIGHT_DATA_PROXY_URL=
